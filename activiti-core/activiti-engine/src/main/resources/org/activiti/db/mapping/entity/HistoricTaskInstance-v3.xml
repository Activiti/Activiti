<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.activiti.engine.impl.persistence.entity.HistoricTaskInstanceEntityImpl">
  <!-- HISTORIC TASK INSTANCE SELECT (V2 - withoutJoins) -->

  <!--
    <include refid="withoutJoins_selectHistoricTaskInstanceCountByQueryCriteria"/>
    <include refid="withoutJoins_selectHistoricTaskInstancesByQueryCriteria"/>
  -->

  <!-- optimized script -->
  <sql id="v3_selectHistoricTaskInstanceCountByQueryCriteria">
    select count(uniqueId) from (
      <include refid="v3_selectHistoricTaskInstancesByQueryCriteriaSql">
        <property name="isCount" value="true"/>
      </include>
    ) sub
  </sql>
  <sql id="v3_selectHistoricTaskInstancesByQueryCriteria">
    select * from (
    <include refid="v3_selectHistoricTaskInstancesByQueryCriteriaSql">
      <property name="isCount" value="false"/>
    </include>
    <choose>
      <when test="'${v3_limitAfter}' != null and _databaseId != 'mssql' and _databaseId != 'oracle'">
        ${orderBy}
        ${v3_limitAfter}
      </when>
      <otherwise>
        ${v3_limitAfter}
        ORDER BY rnk
      </otherwise>
    </choose>
  </sql>

  <sql id="v3_selectHistoricTaskInstancesByQueryCriteriaSql">
    <include refid="v3_selectColumnsSql">
      <property name="isCount" value="${isCount}"/>
    </include>
    from ${prefix}ACT_HI_TASKINST RES
    <include refid="v3_commonSelectHistoricTaskInstancesByQueryCriteriaSql"/>
  </sql>

  <sql id="v3_commonSelectHistoricTaskInstancesByQueryCriteriaSql">
    <!-- variables -->
    <choose>
      <when test="includeTaskLocalVariables &amp;&amp; includeProcessVariables">
        left join ${prefix}ACT_RU_VARIABLE VAR ON RES.ID_ = VAR.TASK_ID_ or RES.PROC_INST_ID_ = VAR.EXECUTION_ID_
      </when>
      <otherwise>
        <if test="includeTaskLocalVariables">
          left join ${prefix}ACT_RU_VARIABLE VAR ON RES.ID_ = VAR.TASK_ID_
        </if>
        <if test="includeProcessVariables">
          left join ${prefix}ACT_RU_VARIABLE VAR ON RES.PROC_INST_ID_ = VAR.EXECUTION_ID_ and VAR.TASK_ID_ is null
        </if>
      </otherwise>
    </choose>
    <!-- left joins -->
    <if test="candidateUser != null || candidateGroups != null">
      left join ${prefix}ACT_HI_IDENTITYLINK link
        on RES.ID_ = link.TASK_ID_
        and RES.ASSIGNEE_ is null
        and link.TYPE_ = 'candidate'
        and
        <trim prefix="(" prefixOverrides="OR" suffix=")">
          <if test="candidateUser != null">
            link.USER_ID_ = #{candidateUser}
          </if>
          <if test="candidateGroups != null &amp;&amp; candidateGroups.size() &gt; 0">
            or link.GROUP_ID_ in
            <foreach item="group" index="index" collection="candidateGroups"
                     open="(" separator="," close=")">
              #{group}
            </foreach>
          </if>
        </trim>
      </if>

    <!-- TODO: THERE'S NO BOTHCANDIDATEANDASSIGNED PROPERTY -->
    <!--
    <if test="bothCandidateAndAssigned">
      <if test="userIdForCandidateAndAssignee != null">
        <if test="candidateGroups == null">
          left join ${prefix}ACT_RU_IDENTITYLINK link
          on RES.ID_ = link.TASK_ID_
          and link.TYPE_ = 'candidate'
          and link.USER_ID_ = #{userIdForCandidateAndAssignee}
        </if>
      </if>
      <if test="candidateGroups != null">
        left join ${prefix}ACT_RU_IDENTITYLINK link
        on RES.ID_ = link.TASK_ID_
        and link.TYPE_ = 'candidate'
        and (
        link.USER_ID_ = #{userIdForCandidateAndAssignee}
        <if test="candidateGroups.size() &gt; 0">
          or link.GROUP_ID_ IN
          <foreach item="group" index="index" collection="candidateGroups" open="(" separator="," close=")">
            #{group}
          </foreach>
        </if>
        )
      </if>
    </if>
    -->
    <if test="involvedUser != null">
      left join ${prefix}ACT_HI_IDENTITYLINK link_user
      on RES.ID_ = link_user.TASK_ID_
      and (
        link_user.USER_ID_ = #{involvedUser}
        or RES.ASSIGNEE_ = #{involvedUser}
        or RES.OWNER_ = #{involvedUser}
      )
    </if>
    <if test="involvedGroups != null &amp;&amp; involvedGroups.size() &gt; 0">
      left join ${prefix}ACT_HI_IDENTITYLINK link_groups
      on RES.ID_ = link_groups.TASK_ID_
      and (
        link_groups.TYPE_ = 'participant'
        and link_groups.GROUP_ID_ in
        <foreach item="group" index="index" collection="involvedGroups" open="(" separator="," close=")">
        #{group}
