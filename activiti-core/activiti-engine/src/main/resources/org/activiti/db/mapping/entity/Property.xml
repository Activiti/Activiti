<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.activiti.engine.impl.persistence.entity.PropertyEntityImpl">

  <!-- PROPERTY INSERT -->

  <insert id="insertProperty" parameterType="org.activiti.engine.impl.persistence.entity.PropertyEntityImpl">
      insert into ${prefix}ACT_GE_PROPERTY (
        NAME_,
        VALUE_,
        REV_
      ) values (
        #{name ,jdbcType=${stringType}},
        #{value, jdbcType=${stringType}},
        1
      )
  </insert>

  <insert id="bulkInsertProperty" parameterType="java.util.List">
      INSERT INTO ${prefix}ACT_GE_PROPERTY (NAME_, VALUE_, REV_) VALUES
      <foreach collection="list" item="property" index="index" separator=",">
        (#{property.name ,jdbcType=${stringType}},
         #{property.value, jdbcType=${stringType}},
         1)
      </foreach>
  </insert>

  <insert id="bulkInsertProperty" databaseId="oracle" parameterType="java.util.List">
    INSERT ALL
    <foreach collection="list" item="property" index="index">
      INTO ${prefix}ACT_GE_PROPERTY (NAME_, VALUE_, REV_) VALUES
      (#{property.name ,jdbcType=${stringType}},
       #{property.value, jdbcType=${stringType}},
       1)
    </foreach>
    SELECT * FROM dual
  </insert>

  <!-- PROPERTY UPDATE -->

  <update id="updateProperty" parameterType="org.activiti.engine.impl.persistence.entity.PropertyEntityImpl">
    update ${prefix}ACT_GE_PROPERTY
    <set>
      REV_ = #{revisionNext, jdbcType=INTEGER},
      VALUE_ = #{value, jdbcType=${stringType}}
    </set>
    where NAME_ = #{name, jdbcType=${stringType}}
      and REV_ = #{revision, jdbcType=INTEGER}
  </update>

  <!-- PROPERTY DELETE -->

  <delete id="deleteProperty" parameterType="org.activiti.engine.impl.persistence.entity.PropertyEntityImpl">
    delete from ${prefix}ACT_GE_PROPERTY where NAME_ = #{name} and REV_ = #{revision}
  </delete>


  <!-- PROPERTY SELECT -->

  <resultMap id="propertyResultMap" type="org.activiti.engine.impl.persistence.entity.PropertyEntityImpl">
    <id property="name" column="NAME_" jdbcType="${stringType}" />
    <result property="value" column="VALUE_" jdbcType="${stringType}" />
    <result property="revision" column="REV_" jdbcType="INTEGER" />
  </resultMap>

  <select id="selectDbSchemaVersion" resultType="string">
    select VALUE_ from ${prefix}ACT_GE_PROPERTY where NAME_ = 'schema.version'
  </select>

  <select id="selectProperty" parameterType="string" resultMap="propertyResultMap">
    select * from ${prefix}ACT_GE_PROPERTY where NAME_ = #{name, jdbcType=${stringType}}
  </select>

  <select id="selectProperties" resultMap="propertyResultMap">
    select * from ${prefix}ACT_GE_PROPERTY
  </select>

</mapper>
