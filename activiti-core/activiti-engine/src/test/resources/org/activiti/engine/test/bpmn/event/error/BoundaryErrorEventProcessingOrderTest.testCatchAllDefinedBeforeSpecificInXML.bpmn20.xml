<?xml version="1.0" encoding="UTF-8"?>
<definitions id="definitions"
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:activiti="http://activiti.org/bpmn"
  targetNamespace="Examples">

  <error id="notFound" errorCode="NOT_FOUND" />
  <error id="timeout" errorCode="TIMEOUT" />

  <process id="catchAllBeforeSpecific">

    <startEvent id="theStart" />
    <sequenceFlow id="flow1" sourceRef="theStart" targetRef="subprocess" />

    <subProcess id="subprocess">
      <startEvent id="subprocessStart" />
      <sequenceFlow id="subFlow1" sourceRef="subprocessStart" targetRef="subprocessEnd" />
      <endEvent id="subprocessEnd">
        <errorEventDefinition errorRef="notFound" />
      </endEvent>
    </subProcess>

    <!-- This mimics the "broken" scenario from /code/explanations/error-boundary-samples/broken -->
    <!-- Catch-all is defined FIRST, specific handlers AFTER -->

    <!-- Catch-all defined FIRST (should NOT execute) -->
    <boundaryEvent id="catchAllError" cancelActivity="true" attachedToRef="subprocess">
      <errorEventDefinition />
    </boundaryEvent>
    <sequenceFlow id="flowCatchAll" sourceRef="catchAllError" targetRef="catchAllTask" />
    <userTask id="catchAllTask" name="Any Error Task" />
    <sequenceFlow id="flowCatchAllEnd" sourceRef="catchAllTask" targetRef="endCatchAll" />
    <endEvent id="endCatchAll" />

    <!-- NOT_FOUND handler defined SECOND (SHOULD execute) -->
    <boundaryEvent id="catchNotFoundError" cancelActivity="true" attachedToRef="subprocess">
      <errorEventDefinition errorRef="notFound" />
    </boundaryEvent>
    <sequenceFlow id="flowNotFound" sourceRef="catchNotFoundError" targetRef="notFoundTask" />
    <userTask id="notFoundTask" name="Not Found Handler Task" />
    <sequenceFlow id="flowNotFoundEnd" sourceRef="notFoundTask" targetRef="endNotFound" />
    <endEvent id="endNotFound" />

    <!-- TIMEOUT handler defined THIRD (won't match) -->
    <boundaryEvent id="catchTimeoutError" cancelActivity="true" attachedToRef="subprocess">
      <errorEventDefinition errorRef="timeout" />
    </boundaryEvent>
    <sequenceFlow id="flowTimeout" sourceRef="catchTimeoutError" targetRef="timeoutTask" />
    <userTask id="timeoutTask" name="Timeout Handler Task" />
    <sequenceFlow id="flowTimeoutEnd" sourceRef="timeoutTask" targetRef="endTimeout" />
    <endEvent id="endTimeout" />

    <sequenceFlow id="flow2" sourceRef="subprocess" targetRef="theEnd" />
    <endEvent id="theEnd" />

  </process>

</definitions>
