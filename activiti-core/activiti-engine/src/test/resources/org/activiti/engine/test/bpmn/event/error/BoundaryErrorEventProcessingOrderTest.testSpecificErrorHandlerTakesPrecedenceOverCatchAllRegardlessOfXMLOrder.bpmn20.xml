<?xml version="1.0" encoding="UTF-8"?>
<definitions id="definitions"
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:activiti="http://activiti.org/bpmn"
  targetNamespace="Examples">

  <error id="error123" errorCode="123" />

  <process id="specificHandlerPrecedence">

    <startEvent id="theStart" />
    <sequenceFlow id="flow1" sourceRef="theStart" targetRef="subprocess" />

    <subProcess id="subprocess">
      <startEvent id="subprocessStart" />
      <sequenceFlow id="subFlow1" sourceRef="subprocessStart" targetRef="subprocessEnd" />
      <endEvent id="subprocessEnd">
        <errorEventDefinition errorRef="error123" />
      </endEvent>
    </subProcess>

    <!-- Catch-all boundary event defined FIRST in XML (should NOT execute) -->
    <boundaryEvent id="catchAllError" cancelActivity="true" attachedToRef="subprocess">
      <errorEventDefinition />
    </boundaryEvent>
    <sequenceFlow id="flowCatchAll" sourceRef="catchAllError" targetRef="catchAllTask" />
    <userTask id="catchAllTask" name="Catch All Handler Task" />
    <sequenceFlow id="flowCatchAllEnd" sourceRef="catchAllTask" targetRef="endCatchAll" />
    <endEvent id="endCatchAll" />

    <!-- Specific error handler defined SECOND in XML (SHOULD execute) -->
    <boundaryEvent id="catchSpecificError" cancelActivity="true" attachedToRef="subprocess">
      <errorEventDefinition errorRef="error123" />
    </boundaryEvent>
    <sequenceFlow id="flowSpecific" sourceRef="catchSpecificError" targetRef="specificErrorTask" />
    <userTask id="specificErrorTask" name="Specific Error Handler Task" />
    <sequenceFlow id="flowSpecificEnd" sourceRef="specificErrorTask" targetRef="endSpecific" />
    <endEvent id="endSpecific" />

    <sequenceFlow id="flow2" sourceRef="subprocess" targetRef="theEnd" />
    <endEvent id="theEnd" />

  </process>

</definitions>
