<?xml version="1.0" encoding="UTF-8"?>
<definitions id="definitions"
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:activiti="http://activiti.org/bpmn"
  targetNamespace="Examples">

  <error id="errorUnknown" errorCode="ERROR_UNKNOWN" />
  <error id="error1" errorCode="ERROR_1" />
  <error id="error2" errorCode="ERROR_2" />

  <process id="catchAllFallback">

    <startEvent id="theStart" />
    <sequenceFlow id="flow1" sourceRef="theStart" targetRef="subprocess" />

    <subProcess id="subprocess">
      <startEvent id="subprocessStart" />
      <sequenceFlow id="subFlow1" sourceRef="subprocessStart" targetRef="subprocessEnd" />
      <endEvent id="subprocessEnd">
        <errorEventDefinition errorRef="errorUnknown" />
      </endEvent>
    </subProcess>

    <!-- Specific error handler for ERROR_1 (won't match) -->
    <boundaryEvent id="catchError1" cancelActivity="true" attachedToRef="subprocess">
      <errorEventDefinition errorRef="error1" />
    </boundaryEvent>
    <sequenceFlow id="flowError1" sourceRef="catchError1" targetRef="error1Task" />
    <userTask id="error1Task" name="Error 1 Handler Task" />
    <sequenceFlow id="flowError1End" sourceRef="error1Task" targetRef="endError1" />
    <endEvent id="endError1" />

    <!-- Specific error handler for ERROR_2 (won't match) -->
    <boundaryEvent id="catchError2" cancelActivity="true" attachedToRef="subprocess">
      <errorEventDefinition errorRef="error2" />
    </boundaryEvent>
    <sequenceFlow id="flowError2" sourceRef="catchError2" targetRef="error2Task" />
    <userTask id="error2Task" name="Error 2 Handler Task" />
    <sequenceFlow id="flowError2End" sourceRef="error2Task" targetRef="endError2" />
    <endEvent id="endError2" />

    <!-- Catch-all boundary event (SHOULD match as fallback) -->
    <boundaryEvent id="catchAllError" cancelActivity="true" attachedToRef="subprocess">
      <errorEventDefinition />
    </boundaryEvent>
    <sequenceFlow id="flowCatchAll" sourceRef="catchAllError" targetRef="catchAllTask" />
    <userTask id="catchAllTask" name="Catch All Handler Task" />
    <sequenceFlow id="flowCatchAllEnd" sourceRef="catchAllTask" targetRef="endCatchAll" />
    <endEvent id="endCatchAll" />

    <sequenceFlow id="flow2" sourceRef="subprocess" targetRef="theEnd" />
    <endEvent id="theEnd" />

  </process>

</definitions>
