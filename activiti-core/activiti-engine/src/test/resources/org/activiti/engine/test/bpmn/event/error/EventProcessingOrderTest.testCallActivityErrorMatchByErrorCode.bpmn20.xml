<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:activiti="http://activiti.org/bpmn"
             targetNamespace="http://www.activiti.org/test">

  <error id="ERR_PARENT" errorCode="BUSINESS_ERROR"/>
  <error id="ERR_CHILD" errorCode="BUSINESS_ERROR"/>

  <process id="parentProcess" name="Parent Process" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow sourceRef="start" targetRef="callChild"/>

    <callActivity id="callChild" name="Call Child" calledElement="childProcess"/>
    <sequenceFlow sourceRef="callChild" targetRef="end"/>

    <boundaryEvent id="errorBoundary" attachedToRef="callChild">
      <errorEventDefinition errorRef="ERR_PARENT"/>
    </boundaryEvent>
    <sequenceFlow sourceRef="errorBoundary" targetRef="errorHandledByCode"/>

    <userTask id="errorHandledByCode" name="Error Handled by Code"/>
    <sequenceFlow sourceRef="errorHandledByCode" targetRef="end"/>

    <endEvent id="end"/>
  </process>

  <process id="childProcess" name="Child Process" isExecutable="true">
    <startEvent id="childStart"/>
    <sequenceFlow sourceRef="childStart" targetRef="throwError"/>

    <endEvent id="throwError">
      <errorEventDefinition errorRef="ERR_CHILD"/>
    </endEvent>
  </process>
</definitions>
