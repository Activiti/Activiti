<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:activiti="http://activiti.org/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Activiti Modeler" exporterVersion="3.0.0-beta.3">
  <bpmn:error id="codeErrorDefinition" name="Code Error" errorCode="CODE_ERROR" />
  <bpmn:process id="errorThrownFromCodeOutputMapping" name="errorThrownFromCodeOutputMapping" isExecutable="true">
    <bpmn:startEvent id="theStart">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow1" sourceRef="theStart" targetRef="throwingServiceTask" />
    <!-- The delegate throws new BpmnError("CODE_ERROR"): only the error code is known, like a connector error -->
    <bpmn:serviceTask id="throwingServiceTask" name="Throwing service task" activiti:class="org.activiti.spring.boot.process.ThrowCodeBpmnErrorDelegate">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow2" sourceRef="throwingServiceTask" targetRef="theEnd" />
    <bpmn:endEvent id="theEnd">
      <bpmn:incoming>flow2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="catchCodeError" attachedToRef="throwingServiceTask">
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="codeErrorDefinition" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow3" sourceRef="catchCodeError" targetRef="codeErrorTask" />
    <bpmn:userTask id="codeErrorTask" name="Code Error Task" activiti:candidateUsers="user">
      <bpmn:incoming>flow3</bpmn:incoming>
      <bpmn:outgoing>flow4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow4" sourceRef="codeErrorTask" targetRef="errorEnd" />
    <bpmn:endEvent id="errorEnd">
      <bpmn:incoming>flow4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
