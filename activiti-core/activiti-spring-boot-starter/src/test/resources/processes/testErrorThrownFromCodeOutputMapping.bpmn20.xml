      <bpmndi:BPMNShape id="theStart_di" bpmnElement="theStart">
        <dc:Bounds x="152" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="throwingServiceTask_di" bpmnElement="throwingServiceTask">
        <dc:Bounds x="250" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="theEnd_di" bpmnElement="theEnd">
        <dc:Bounds x="412" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="catchCodeError_di" bpmnElement="catchCodeError">
        <dc:Bounds x="282" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="codeErrorTask_di" bpmnElement="codeErrorTask">
        <dc:Bounds x="250" y="300" width="100" height="80" />
