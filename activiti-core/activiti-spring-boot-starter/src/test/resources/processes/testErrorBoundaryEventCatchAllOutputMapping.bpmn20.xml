  <!-- Intentionally NO <bpmn:error> element for "REQUEST_TIMEOUT" to simulate an undefined connector error -->
  <bpmn:error id="knownErrorId" name="Known Error" errorCode="KNOWN_ERROR" />
  <bpmn:process id="errorBoundaryCatchAllOutputMapping" name="errorBoundaryCatchAllOutputMapping" isExecutable="true">
    <bpmn:startEvent id="theStart">
      <bpmn:outgoing>flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="subProcess">
      <bpmn:incoming>flow1</bpmn:incoming>
      <bpmn:outgoing>flow3</bpmn:outgoing>
      <bpmn:startEvent id="subStart">
        <bpmn:outgoing>flow2</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="flow2" sourceRef="subStart" targetRef="subEnd" />
      <bpmn:endEvent id="subEnd">
        <bpmn:incoming>flow2</bpmn:incoming>
        <!-- Throws REQUEST_TIMEOUT which has no <bpmn:error> definition -->
        <bpmn:errorEventDefinition errorRef="knownErrorId" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow1" sourceRef="theStart" targetRef="subProcess" />
    <bpmn:endEvent id="theEnd">
      <bpmn:incoming>flow3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow3" sourceRef="subProcess" targetRef="theEnd" />
    <!-- Catch-all boundary event: no errorRef, catches any error -->
    <bpmn:boundaryEvent id="catchAllError" attachedToRef="subProcess">
      <bpmn:outgoing>flow4</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow4" sourceRef="catchAllError" targetRef="errorTask" />
    <bpmn:endEvent id="errorEnd">
      <bpmn:incoming>flow5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="errorTask" name="Catch All Task" activiti:candidateUsers="user">
      <bpmn:incoming>flow4</bpmn:incoming>
      <bpmn:outgoing>flow5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow5" sourceRef="errorTask" targetRef="errorEnd" />
  </bpmn:process>
