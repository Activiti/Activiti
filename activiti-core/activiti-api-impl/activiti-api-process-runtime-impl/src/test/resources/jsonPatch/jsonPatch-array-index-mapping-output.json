                  "path": "/byId/${arrayIndex}",
                  "value": "${item}"
                }
              ]
            }
          }
        },
        "multipleIndexedWrites": {
          "outputs": {
            "emptyJson": {
              "type": "JSONPATCH",
              "value": [
                {
                  "op": "add",
                  "path": "/documents/0",
                  "value": "X"
                },
                {
                  "op": "add",
                  "path": "/documents/1",
                  "value": "Y"
                }
              ]
            }
          }
        },
